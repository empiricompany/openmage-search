<?xml version="1.0"?>
<layout>
    <!-- Popular Queries Page -->
    <adminhtml_mm_search_analytics_queries>
        <reference name="content">
            <block type="mm_search/adminhtml_analytics_queries" name="analytics.queries">
                <block type="mm_search/adminhtml_analytics_queries_grid" name="analytics.queries.grid" as="grid"/>
            </block>
        </reference>
    </adminhtml_mm_search_analytics_queries>
    
    <!-- No Hits Queries Page -->
    <adminhtml_mm_search_analytics_nohits>
        <reference name="content">
            <block type="mm_search/adminhtml_analytics_nohits" name="analytics.nohits">
                <block type="mm_search/adminhtml_analytics_nohits_grid" name="analytics.nohits.grid" as="grid"/>
            </block>
        </reference>
    </adminhtml_mm_search_analytics_nohits>
    
    <!-- Synonyms List Page -->
    <adminhtml_mm_search_synonyms_index>
        <reference name="content">
            <block type="mm_search/adminhtml_synonyms" name="synonyms">
                <block type="mm_search/adminhtml_synonyms_grid" name="synonyms.grid" as="grid"/>
            </block>
        </reference>
    </adminhtml_mm_search_synonyms_index>
    
    <!-- Synonyms Edit/New Page -->
    <adminhtml_mm_search_synonyms_edit>
        <reference name="content">
            <block type="mm_search/adminhtml_synonyms_edit" name="synonyms.edit"/>
        </reference>
    </adminhtml_mm_search_synonyms_edit>
    
    <!-- Synonyms New Page (uses same layout as edit) -->
    <adminhtml_mm_search_synonyms_new>
        <update handle="adminhtml_mm_search_synonyms_edit"/>
    </adminhtml_mm_search_synonyms_new>
</layout>